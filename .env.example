# Copy to .env.local for development and .env.test for the test suite.
# Never commit either: .gitignore excludes .env* apart from this example.

# --- Database -----------------------------------------------------------
# The compose service publishes on DB_PORT (default 5437). Set DB_PORT if that
# port is taken and keep the URLs below in step with it.
DB_PORT=5437
DATABASE_URL=postgres://house:house@localhost:5437/house
# In .env.test point this at the test database. The suite refuses to run
# against a database whose name does not mark it as a test one.
# DATABASE_URL=postgres://house:house@localhost:5437/house_test

# --- The one account nobody can register as -----------------------------
# Read once, on first boot, to create the owner. Changing the password here
# after it has been changed in the application has no effect.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me-before-first-boot

# --- Cloudflare R2 ------------------------------------------------------
# Use a separate bucket per environment, each with a token scoped to that
# bucket alone, so a leaked development credential cannot reach real files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=house-files-dev
